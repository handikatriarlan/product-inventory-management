# Database (dipakai service `db` dan dirakit menjadi DATABASE_URL backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db_inventory

# Port yang diekspos ke host
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Base URL API untuk build frontend.
# Kosongkan untuk same-origin (nginx mem-proxy /products, /uploads, /health).
VITE_API_BASE_URL=
