generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int
  category    String?
  status      ProductStatus @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}
