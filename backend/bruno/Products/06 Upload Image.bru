meta {
  name: Upload Image
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/products/{{productId}}/image
  body: multipartForm
  auth: none
}

body:multipart-form {
  image: @file({{imageFile}})
}

tests {
  test("status 200 dan imageUrl terisi", function() {
    expect(res.status).to.equal(200)
    expect(res.body.data.imageUrl).to.include("/uploads/")
  })
}
