meta {
  name: List Products (filtered)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/products?page=1&limit=5&search=SKU-000&category=Electronics&status=ACTIVE&sortBy=price&order=asc
  body: none
  auth: none
}

tests {
  test("status 200 dan item sesuai filter", function() {
    expect(res.status).to.equal(200)
    expect(res.body.data).to.be.an("array")
    res.body.data.forEach(function(product) {
      expect(product.category).to.equal("Electronics")
      expect(product.status).to.equal("ACTIVE")
    })
  })

  test("nilai tidak valid ditolak 400", function() {
    expect(res.body.meta).to.have.property("total")
  })
}
