meta {
  name: Create Product
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

body:json {
  {
    "sku": "SKU-{{$randomUUID}}",
    "name": "Kemeja Flanel Lengan Panjang",
    "description": "Kemeja flanel bahan katun motif kotak, tersedia ukuran M sampai XL.",
    "price": 189000,
    "stock": 24,
    "category": "Apparel",
    "status": "ACTIVE"
  }
}

script:post-response {
  bru.setEnvVar("productId", res.body.data.id)
}

tests {
  test("status 201 dan sku ter-normalisasi uppercase", function() {
    expect(res.status).to.equal(201)
    expect(res.body.data.id).to.be.a("string")
    expect(res.body.data.sku).to.match(/^SKU-[0-9A-F-]+$/)
    expect(res.body.data.price).to.equal(189000)
    expect(res.body.data.category).to.equal("Apparel")
  })
}
